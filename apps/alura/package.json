    "deva": "concurrently -k -n SERVER,ADMIN -c cyan,blue \"pnpm --filter=server dev\" \"pnpm --filter=admin dev\"",
    "build": "pnpm --filter=server build && pnpm --filter=client build && pnpm --filter=admin build"
  },
